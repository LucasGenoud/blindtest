# ─── Client (SvelteKit) ───────────────────────────────────────────────────────

# Port the SvelteKit Node.js server listens on inside its container.
# Must match the port exposed in docker-compose.yml (default: 3000).
CLIENT_PORT=3000

# Public URL of the client. Used by SvelteKit for CSRF / origin validation.
# Must match the URL users actually open in their browser.
CLIENT_ORIGIN=http://localhost:3000

# ─── Client build-time environment (baked into the JS bundle) ─────────────────
# These are resolved at `npm run build` time, not at runtime.

# Full URL of the backend HTTP API, as reachable from the user's browser.
VITE_API_URL=http://localhost:3080

# Full WebSocket URL of the backend, as reachable from the user's browser.
VITE_WS_URL=ws://localhost:3080/ws

# ─── Server (Rust / Actix-web) ────────────────────────────────────────────────

# Comma-separated list of allowed frontend origins for CORS.
# Must match CLIENT_ORIGIN (and any other trusted origins).
# If unset, the server allows any origin (fine for local dev, not for prod).
FRONTEND_URL=http://localhost:3000

# ─── S3 / SeaweedFS ───────────────────────────────────────────────────────────
SEAWEEDFS_ACCESS_KEY=
SEAWEEDFS_SECRET_KEY=
SEAWEEDFS_DEFAULT_BUCKET=

SERVER_S3_ENDPOINT=
SERVER_S3_ACCESS_KEY=
SERVER_S3_SECRET_KEY=
SERVER_S3_BUCKET=
SERVER_S3_REGION=

# ─── Blindtest assistant (optional) ───────────────────────────────────────────
# Any OpenAI-compatible /chat/completions endpoint: OpenAI, OpenRouter, Groq,
# together.ai, a local Ollama or llama.cpp, and so on. Set LLM_BASE_URL and
# LLM_MODEL to switch the assistant on; leave either blank and the feature stays
# hidden in the client.

# Base URL up to but NOT including /chat/completions.
LLM_BASE_URL=
# e.g. gpt-4o-mini, llama-3.3-70b-versatile, qwen2.5:14b
LLM_MODEL=
# Omit for local servers that do not authenticate.
LLM_API_KEY=

# Context window this ENDPOINT serves — not what the model card claims. A vLLM or
# llama.cpp started with --max-model-len 32768 refuses a bigger prompt even if the
# model supports more. Raise it and the whole library reaches the model; too low
# and clips get trimmed away (a warning is logged when that happens).
# LLM_CONTEXT_TOKENS=32768

# Reasoning models ("thinking" models such as Qwen3) spend output tokens on their
# working out before writing the answer, so give them room — or turn thinking off:
# LLM_EXTRA_BODY={"chat_template_kwargs":{"enable_thinking":false}}
# LLM_EXTRA_BODY is merged verbatim into every request body, for provider-specific
# switches this client knows nothing about.
# LLM_EXTRA_BODY=

# Optional tuning.
# LLM_RESERVE_TOKENS=1500  # window kept back for the answer; also sent as max_tokens.
#                          # The answer is ~350 tokens; raise it only for a thinking model.
# LLM_TIMEOUT_SECS=120     # a whole-library request is not a fast call
# LLM_TEMPERATURE=0.4
# LLM_JSON_MODE=true       # set false if the provider rejects response_format
# LLM_MAX_CATALOG=4000     # most-played clips offered to the model, at most
