# ─── Client (SvelteKit) ───────────────────────────────────────────────────────

# Port the SvelteKit Node.js server listens on inside its container.
# Must match the port exposed in docker-compose.yml (default: 3000).
CLIENT_PORT=3000

# Public URL of the client. Used by SvelteKit for CSRF / origin validation.
# Must match the URL users actually open in their browser.
CLIENT_ORIGIN=http://localhost:3000

# ─── Client build-time environment (baked into the JS bundle) ─────────────────
# These are resolved at `npm run build` time, not at runtime.

# Full URL of the backend HTTP API, as reachable from the user's browser.
VITE_API_URL=http://localhost:3080

# Full WebSocket URL of the backend, as reachable from the user's browser.
VITE_WS_URL=ws://localhost:3080/ws

# ─── Server (Rust / Actix-web) ────────────────────────────────────────────────

# Comma-separated list of allowed frontend origins for CORS.
# Must match CLIENT_ORIGIN (and any other trusted origins).
# If unset, the server allows any origin (fine for local dev, not for prod).
FRONTEND_URL=http://localhost:3000

# ─── S3 / SeaweedFS ───────────────────────────────────────────────────────────
SEAWEEDFS_ACCESS_KEY=
SEAWEEDFS_SECRET_KEY=
SEAWEEDFS_DEFAULT_BUCKET=

SERVER_S3_ENDPOINT=
SERVER_S3_ACCESS_KEY=
SERVER_S3_SECRET_KEY=
SERVER_S3_BUCKET=
SERVER_S3_REGION=
